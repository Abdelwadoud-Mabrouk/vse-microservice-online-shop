<configuration>

    <!--
        Nutzt die Spring-Property LOG_PATH oder den Umgebungsparameter LOG_PATH.
        Fallback auf './logs' im Projektordner, wenn nichts angegeben ist (z.B. lokal in IntelliJ).
    -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>

    <!-- =========================
         File Logging
         ========================= -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Dynamischer Pfad basierend auf LOG_PATH -->
        <file>${LOG_PATH}/shop-service.json</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/shop-service.%d{yyyy-MM-dd}.json
            </fileNamePattern>

            <!-- Genau 14 Tage Aufbewahrung -->
            <maxHistory>14</maxHistory>

        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <!-- ISO-8601 UTC Timestamp -->
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>

                <!-- Level INFO/WARN/ERROR -->
                <logLevel/>

                <!-- Logger Klasse -->
                <loggerName/>

                <!-- Service Name (Korrektes Tag zur Vermeidung der Logback-Warnung) -->
                <customFields>
                    {"service":"shop-service"}
                </customFields>

                <!-- Message -->
                <message/>

                <!-- MDC enthält correlationId -->
                <mdc/>

                <!-- kv() aus StructuredArguments -->
                <arguments/>

                <!-- Exception Stacktrace -->
                <stackTrace/>
            </providers>
        </encoder>

    </appender>

    <!-- =========================
         Console Logging
         ========================= -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <logLevel/>
                <customFields>
                    {"service":"shop-service"}
                </customFields>
                <message/>
                <mdc/>
                <arguments/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <!-- =========================
         Root Logger
         ========================= -->

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>