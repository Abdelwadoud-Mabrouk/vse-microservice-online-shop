ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

AUDIT_DB_NAME=audit
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=audit

WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PASSWORD=warehouse

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PAYMENT_SUCCEEDED_TOPIC=payment-succeeded
KAFKA_AUDIT_EVENTS_TOPIC=audit-events
KAFKA_INVOICE_CONSUMER_GROUP=invoice-service
KAFKA_AUDIT_CONSUMER_GROUP=audit-service

FRONTEND_ADMIN_URL=http://localhost:3001/admin

SHOP_DB_URL=jdbc:postgresql://shop-db:5432/shop_db
SHOP_DB_USERNAME=shop_user
SHOP_DB_PASSWORD=change-me

BILLING_DB_URL=jdbc:postgresql://billing-db:5432/billing_db
BILLING_DB_USERNAME=billing_user
BILLING_DB_PASSWORD=change-me

# Insert local sandbox/test credentials only in .env. Never commit real provider secrets.
STRIPE_SECRET_KEY=replace-with-test-key
STRIPE_WEBHOOK_SECRET=replace-with-test-secret
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
